17:["$","section","core-mental-model",{"id":"core-mental-model","className":"scroll-mt-24 space-y-4","children":[["$","h2",null,{"className":"text-xl font-bold text-(--text-primary) border-b border-(--border-color) pb-2","children":"Core Mental Model"}],["$","p",null,{"className":"text-sm text-(--text-secondary) leading-relaxed whitespace-pre-line","children":"Subatom Infer follows five core principles:\n1. Schemas are immutable objects created via factories like infer.string() or infer.object().\n2. Modifiers return a new Schema instance without mutating existing instances.\n3. Parsing evaluates a single shared ParseContext across nested paths.\n4. Safe parsing guarantees your process will never throw an uncaught exception.\n5. Inferred types (Infer<S>, Output<S>, Input<S>) mirror the transformation lifecycle exactly."}],"$undefined"]}]
18:["$","section","dual-engine-architecture",{"id":"dual-engine-architecture","className":"scroll-mt-24 space-y-4","children":[["$","h2",null,{"className":"text-xl font-bold text-(--text-primary) border-b border-(--border-color) pb-2","children":"Dual Engine (Sync & Async)"}],["$","p",null,{"className":"text-sm text-(--text-secondary) leading-relaxed whitespace-pre-line","children":"Subatom Infer implements an ultra-optimized synchronous engine by default, achieving millions of validations per second. When asynchronous transforms, database checks, or promises are supplied, the schema branches into an asynchronous engine via .parseAsync() or .safeParseAsync() (aliased as .spa())."}],["$","$L16",null,{"ts":"// Synchronous execution\nconst res1 = User.safeParse(input);\n\n// Asynchronous execution\nconst res2 = await User.safeParseAsync(input);","js":"// Synchronous execution\nconst res1 = User.safeParse(input);\n\n// Asynchronous execution\nconst res2 = await User.safeParseAsync(input);"}]]}]
19:["$","section","prototype-defense",{"id":"prototype-defense","className":"scroll-mt-24 space-y-4","children":[["$","h2",null,{"className":"text-xl font-bold text-(--text-primary) border-b border-(--border-color) pb-2","children":"Built-In Prototype Pollution Defense"}],["$","p",null,{"className":"text-sm text-(--text-secondary) leading-relaxed whitespace-pre-line","children":"Unlike naive object mappers, Subatom Infer enforces defensive object creation across infer.object(), .passthrough(), and .merge(). Keys such as __proto__ and constructor are stripped to protect against malicious prototype injection."}],"$undefined"]}]
