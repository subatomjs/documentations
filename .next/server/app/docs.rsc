email: infer.string().email(),\n  role: infer.enum([\"admin\", \"member\"]).default(\"member\"),\n  createdAt: infer.coerce.date().default(() => new Date())\n});"}]]}],"$L17","$L18","$L19"]}],"$L1a"]}],"$L1b"]}],["$L1c","$L1d"],"$L1e"]}]
