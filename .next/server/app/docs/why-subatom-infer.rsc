"}],"$undefined",["$","$L20",null,{"ts":"// Compile-time only (does NOT validate at runtime)\ninterface PostInput {\n  title: string;\n  tags: string[];\n}\n\n// Subatom Infer: Validates at runtime AND infers identical TypeScript types\nconst PostSchema = infer.object({\n  title: infer.string().min(1),\n  tags: infer.array(infer.string()).nonempty()\n});\ntype Post = Infer<typeof PostSchema>;","js":"// Subatom Infer runtime schema validation\nimport { infer } from \"subatom-infer\";\n\nconst PostSchema = infer.object({\n  title: infer.string().min(1),\n  tags: infer.array(infer.string()).nonempty()\n});"}]]}],["$","section","the-trust-boundary",{"id":"the-trust-boundary","className":"scroll-mt-24 space-y-4","children":[["$","h2",null,{"className":"text-xl font-bold text-(--text-primary) border-b border-(--border-color) pb-2","children":"Crossing Trust Boundaries"}],["$","p",null,{"className":"text-sm text-(--text-secondary) leading-relaxed whitespace-pre-line","children":"Whenever data enters from external sources—HTTP requests, JSON files, environment variables, or databases—you are at a trust boundary. Subatom Infer transforms unknown input into verified, typed domain values."}],"$undefined","$undefined"]}],["$","section","performance-and-security",{"id":"performance-and-security","className":"scroll-mt-24 space-y-4","children":[["$","h2",null,{"className":"text-xl font-bold text-(--text-primary) border-b border-(--border-color) pb-2","children":"Security & Zero Dependencies"}],["$","p",null,{"className":"text-sm text-(--text-secondary) leading-relaxed whitespace-pre-line","children":"Built with zero third-party dependencies, Subatom Infer eliminates supply chain vulnerabilities while delivering minimal bundle footprint and top-tier execution speeds."}],"$undefined","$undefined"]}]]}],["$","div",null,{"className":"mt-12 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-(--border-color) pt-6","children":["$L21","$L22"]}]]}],"$L23"]}]
